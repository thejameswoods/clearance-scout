# Copy to .env and fill in. Never commit the real .env.

# --- Postgres ---
POSTGRES_DB=clearance_scout
POSTGRES_USER=clearance_scout
POSTGRES_PASSWORD=change-me

# --- Scanner ---
RETAILERS=home_depot
ZIP_CODE=00000
# How far from ZIP_CODE to look for stores — every store in range gets
# scanned, not just the nearest one.
RADIUS_MILES=25
# Comma-separated, case-insensitive substrings. Only departments whose name
# contains one of these are scanned at all (fewer requests, lower detection
# risk). Leave blank to scan every department.
#
# Home Depot's own department names are a full breadcrumb (see
# adapters/home_depot/departments.py), so a broad substring like plain
# "Electrical" matches EVERY sub-department under it -- confirmed live
# 2026-08-31, "Electrical" alone matched 71 real departments and turned one
# scan into several hours and 4,700+ requests (enough to exhaust a 4GB
# container's memory — see GitHub issue #4). Prefer a specific sub-department
# name for a real deployment, e.g. "Electrical Wire" rather than "Electrical".
WATCHED_DEPARTMENTS=Electrical Wire
# Further narrows within watched departments, by product name. Leave blank
# to check every product in a watched department.
WATCH_KEYWORDS=wire
# There's no automatic scanning -- not on a timer, not on container start.
# A scan only ever runs because a human asked for it (dashboard "Scan now" /
# bot /scan). While developing, keep WATCHED_DEPARTMENTS small for a fast
# build-test loop, e.g. "Electrical Batteries AA Batteries" (an exact, tiny,
# real Home Depot department -- a handful of SKUs, seconds not hours).
# How long a department's product-ID list (phase 2 -- which products exist,
# not their current price) stays cached before re-listing from the
# retailer. Current price/clearance (phase 3) is always checked fresh every
# scan regardless of this -- this only skips redundant re-discovery of
# product IDs that rarely change. Default is effectively permanent (a
# department's catalog doesn't meaningfully change day to day); set to 0 to
# always re-list, or a smaller number if you want periodic refreshes.
PRODUCT_LIST_CACHE_HOURS=87600
LOG_LEVEL=INFO
NOVNC_PORT=6901

# --- Web dashboard ---
WEB_PORT=8000

# --- Telegram bot (optional — omit --profile telegram in `docker compose up` to skip) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to bind via /start. Leave blank to let
# whichever chat sends /start first claim the bot (fine for a single-user
# personal deployment, less fine if you expose the bot token more widely).
TELEGRAM_ALLOWED_CHAT_IDS=
# Where the bot links back to for a deal — your dashboard's public URL.
DASHBOARD_URL=http://localhost:8000
