# Copy to .env and fill in. Never commit the real .env.

# --- Postgres ---
POSTGRES_DB=clearance_scout
POSTGRES_USER=clearance_scout
POSTGRES_PASSWORD=change-me

# --- Scanner ---
RETAILERS=home_depot
ZIP_CODE=00000
# How far from ZIP_CODE to look for stores — every store in range gets
# scanned, not just the nearest one.
RADIUS_MILES=25
# Comma-separated, case-insensitive substrings. Only departments whose name
# contains one of these are scanned at all (fewer requests, lower detection
# risk). Leave blank to scan every department.
WATCHED_DEPARTMENTS=Electrical
# Further narrows within watched departments, by product name. Leave blank
# to check every product in a watched department.
# Example: watch only electrical wire within 25 miles —
#   WATCHED_DEPARTMENTS=Electrical
#   WATCH_KEYWORDS=wire
WATCH_KEYWORDS=wire
SCAN_INTERVAL_MINUTES=240
LOG_LEVEL=INFO
NOVNC_PORT=6901

# --- Web dashboard ---
WEB_PORT=8000

# --- Telegram bot (optional — omit --profile telegram in `docker compose up` to skip) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to bind via /start. Leave blank to let
# whichever chat sends /start first claim the bot (fine for a single-user
# personal deployment, less fine if you expose the bot token more widely).
TELEGRAM_ALLOWED_CHAT_IDS=
# Where the bot links back to for a deal — your dashboard's public URL.
DASHBOARD_URL=http://localhost:8000
